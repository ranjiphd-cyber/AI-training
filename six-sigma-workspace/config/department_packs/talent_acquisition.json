{
  "pack_id": "talent_acquisition",
  "label": "Talent Acquisition",
  "version": "0.1-draft",
  "status": "Draft - pending approval",
  "observation_unit_default": "Requisition (or candidate application - choose one per analysis)",
  "core_fields": [
    {
      "field": "record_id",
      "type": "id",
      "description": "Stable identifier of one observation unit",
      "required": true,
      "pii": false
    },
    {
      "field": "segment",
      "type": "category",
      "description": "Configurable segment (business unit, product, region...)",
      "required": false,
      "pii": false
    },
    {
      "field": "site",
      "type": "category",
      "description": "Site/location",
      "required": false,
      "pii": false
    },
    {
      "field": "owner_ref",
      "type": "category",
      "description": "Pseudonymised owner/handler reference (never a name)",
      "required": false,
      "pii": false
    }
  ],
  "standard_fields": [
    {
      "field": "req_open_ts",
      "type": "datetime",
      "description": "Requisition approved/opened",
      "required": true,
      "pii": false
    },
    {
      "field": "first_shortlist_ts",
      "type": "datetime",
      "description": "First shortlist sent to hiring manager",
      "required": false,
      "pii": false
    },
    {
      "field": "first_interview_ts",
      "type": "datetime",
      "description": "First interview held",
      "required": false,
      "pii": false
    },
    {
      "field": "offer_ts",
      "type": "datetime",
      "description": "First offer extended",
      "required": false,
      "pii": false
    },
    {
      "field": "offer_accept_ts",
      "type": "datetime",
      "description": "Offer accepted",
      "required": false,
      "pii": false
    },
    {
      "field": "req_status",
      "type": "category",
      "description": "Current status",
      "required": true,
      "pii": false,
      "allowed_values": [
        "Open",
        "Filled",
        "Cancelled",
        "On hold"
      ]
    },
    {
      "field": "job_family",
      "type": "category",
      "description": "Job family",
      "required": false,
      "pii": false
    },
    {
      "field": "source_channel",
      "type": "category",
      "description": "Hire source",
      "required": false,
      "pii": false
    },
    {
      "field": "candidate_name",
      "type": "text",
      "description": "Candidate name - DO NOT LOAD unless approved",
      "required": false,
      "pii": true
    }
  ],
  "metric_library": [
    {
      "metric_id": "TTO",
      "name": "Time to offer",
      "definition": "Calendar (or business) days from requisition open to first offer",
      "unit": "days",
      "numerator": "-",
      "denominator": "requisitions with an offer",
      "start_event": "req_open_ts",
      "stop_event": "offer_ts",
      "direction_of_improvement": "lower",
      "target_status": "Not set - requires approval",
      "notes": "State calendar vs business days; open reqs are censored."
    },
    {
      "metric_id": "TTF",
      "name": "Time to fill",
      "definition": "Days from requisition open to offer acceptance",
      "unit": "days",
      "numerator": "-",
      "denominator": "filled requisitions",
      "start_event": "req_open_ts",
      "stop_event": "offer_accept_ts",
      "direction_of_improvement": "lower",
      "target_status": "Not set - requires approval",
      "notes": ""
    },
    {
      "metric_id": "OAR",
      "name": "Offer acceptance rate",
      "definition": "Offers accepted / offers extended (same cohort)",
      "unit": "%",
      "numerator": "offers accepted",
      "denominator": "offers extended",
      "start_event": null,
      "stop_event": null,
      "direction_of_improvement": "higher",
      "target_status": "Not set - requires approval",
      "notes": ""
    },
    {
      "metric_id": "HMSAT",
      "name": "Hiring manager satisfaction",
      "definition": "Survey score - ordinal scale, report distribution not only mean",
      "unit": "scale",
      "numerator": "-",
      "denominator": "responses",
      "start_event": null,
      "stop_event": null,
      "direction_of_improvement": "higher",
      "target_status": "Not set - requires approval",
      "notes": ""
    }
  ],
  "process_stages": [
    "Requisition approval",
    "Sourcing",
    "Screening",
    "Interview",
    "Offer",
    "Acceptance",
    "Onboarding"
  ],
  "balancing_measures": [
    "Quality of hire (90-day retention)",
    "Candidate experience",
    "Recruiter workload",
    "Adverse impact review (qualified review only)"
  ],
  "sensitivity_notes": "Minimise individual-level data. Pseudonymise owners. Any fairness, legal or regulatory question requires qualified review."
}