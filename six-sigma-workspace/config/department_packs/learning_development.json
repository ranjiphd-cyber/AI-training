      "pii": false
    },
    {
      "field": "site",
      "type": "category",
      "description": "Site/location",
      "required": false,
      "pii": false
    },
    {
      "field": "owner_ref",
      "type": "category",
      "description": "Pseudonymised owner/handler reference (never a name)",
      "required": false,
      "pii": false
    }
  ],
  "standard_fields": [
    {
      "field": "enrol_ts",
      "type": "datetime",
      "description": "Enrolment",
      "required": true,
      "pii": false
    },
    {
      "field": "complete_ts",
      "type": "datetime",
      "description": "Completion",
      "required": false,
      "pii": false
    },
    {
      "field": "assessment_score",
      "type": "number",
      "description": "Post-assessment score",
      "required": false,
      "pii": false
    },
    {
      "field": "program",
      "type": "category",
      "description": "Programme",
      "required": true,
      "pii": false
    }
